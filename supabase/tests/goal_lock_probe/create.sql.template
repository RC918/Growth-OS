-- Approved NOLOGIN preparation only. NO window, credential, LOGIN or data append activation.
-- Target: isolated Growth OS vhzryhibmpvglzcmfnaa. Contains no password.
BEGIN;
DO $$ BEGIN
 IF EXISTS (SELECT FROM pg_roles WHERE rolname IN ('growth_os_probe_owner','growth_os_probe_login'))
 THEN RAISE EXCEPTION 'Probe role already exists; do not overwrite'; END IF;
 IF EXISTS (SELECT FROM pg_namespace WHERE nspname='growth_os_probe')
 THEN RAISE EXCEPTION 'Probe schema already exists; do not overwrite'; END IF;
 IF EXISTS (SELECT FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
 WHERE n.nspname IN ('public','private') AND p.prosecdef AND EXISTS
 (SELECT FROM aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) x
 WHERE x.grantee=0 AND x.privilege_type='EXECUTE'))
 THEN RAISE EXCEPTION 'Unexpected PUBLIC definer access'; END IF;
 IF EXISTS (SELECT FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
 CROSS JOIN LATERAL aclexplode(coalesce(c.relacl,acldefault('r',c.relowner))) x
 WHERE n.nspname IN ('public','private','auth') AND c.relkind IN ('r','p') AND x.grantee=0)
 THEN RAISE EXCEPTION 'Unexpected PUBLIC table access'; END IF;
END $$;
CREATE ROLE growth_os_probe_owner NOLOGIN NOINHERIT NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE NOREPLICATION;
CREATE ROLE growth_os_probe_login NOLOGIN NOINHERIT NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE NOREPLICATION
 CONNECTION LIMIT 3 VALID UNTIL '1970-01-01 00:00:00+00';
CREATE SCHEMA growth_os_probe;
REVOKE ALL ON SCHEMA growth_os_probe FROM PUBLIC;
CREATE TABLE growth_os_probe.activation_window(singleton boolean PRIMARY KEY CHECK(singleton), starts_at timestamptz, deadline timestamptz,
 CHECK((starts_at IS NULL AND deadline IS NULL) OR
 (starts_at IS NOT NULL AND deadline IS NOT NULL AND deadline-starts_at=interval '2 hours')));
INSERT INTO growth_os_probe.activation_window VALUES(true,NULL,NULL);
REVOKE ALL ON TABLE growth_os_probe.activation_window FROM PUBLIC,anon,authenticated,service_role,growth_os_probe_login;
GRANT SELECT ON TABLE growth_os_probe.activation_window TO growth_os_probe_owner;
GRANT CONNECT ON DATABASE postgres TO growth_os_probe_login;
GRANT USAGE ON SCHEMA growth_os_probe TO growth_os_probe_login;
GRANT USAGE ON SCHEMA growth_os_probe,public,private TO growth_os_probe_owner;
GRANT EXECUTE ON FUNCTION public.save_goal_turn(uuid,uuid,uuid,integer,text,text),
 private.save_goal_turn_impl(uuid,uuid,uuid,integer,text,text) TO growth_os_probe_owner;
-- Temporary CREATE only for ownership transfer; revoked in the same transaction.
GRANT CREATE ON SCHEMA growth_os_probe TO growth_os_probe_owner;
-- PG17 ownership transfer needs SET membership for the DDL operator.
-- This temporary membership is removed before the atomic preparation commits.
GRANT growth_os_probe_owner TO CURRENT_USER WITH SET TRUE, INHERIT FALSE;
CREATE FUNCTION growth_os_probe.append_fixture_turn() RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path='' SET lock_timeout='5s' AS $$
DECLARE result jsonb; starts timestamptz; ends timestamptz;
BEGIN
 SELECT starts_at,deadline INTO starts,ends FROM growth_os_probe.activation_window WHERE singleton;
 IF session_user <> 'growth_os_probe_login' OR starts IS NULL OR ends IS NULL
 OR clock_timestamp() < starts OR clock_timestamp() >= ends
 THEN RAISE EXCEPTION 'Probe caller or window denied' USING errcode='42501'; END IF;
 -- Pin both legacy and JSON claims. The caller cannot choose identity/tenant.
 PERFORM set_config('request.jwt.claim.sub','e85f1a90-3565-4fc1-a7e0-3b7d08830d0e',true);
 PERFORM set_config('request.jwt.claims','{"sub":"e85f1a90-3565-4fc1-a7e0-3b7d08830d0e","role":"authenticated"}',true);
 result := public.save_goal_turn('93a88055-0a0b-40c0-b22f-a6d312320001',
 '5055ca31-40cc-435d-9f52-cdf19166440c',pg_catalog.gen_random_uuid(),13,
 'audience','合成 DB 鎖屏障驗收：固定海外工業採購，無真實客戶資料');
 -- Reject if waiting for the lock carried this call beyond the hard cutoff.
 IF clock_timestamp() >= ends
 THEN RAISE EXCEPTION 'Probe window expired while waiting' USING errcode='42501'; END IF;
 RETURN result;
END $$;
ALTER FUNCTION growth_os_probe.append_fixture_turn() OWNER TO growth_os_probe_owner;
-- Execute object ACL changes AS the owner, before removing temporary SET.
SET LOCAL ROLE growth_os_probe_owner;
REVOKE ALL ON FUNCTION growth_os_probe.append_fixture_turn() FROM PUBLIC,anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION growth_os_probe.append_fixture_turn() TO growth_os_probe_login;
RESET ROLE;
REVOKE CREATE ON SCHEMA growth_os_probe FROM growth_os_probe_owner;
REVOKE growth_os_probe_owner FROM CURRENT_USER;
ALTER ROLE growth_os_probe_login SET statement_timeout='15s';
ALTER ROLE growth_os_probe_login SET lock_timeout='5s';
ALTER ROLE growth_os_probe_login SET idle_in_transaction_session_timeout='30s';
COMMIT;
