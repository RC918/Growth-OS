-- Isolated Growth OS Staging only. Privileged operator replaces both UUID markers
-- with IDs of two real, email-confirmed Supabase Auth test users. Never substitute
-- passwords or access tokens here. Run once, then run auth_data_api_acceptance.py.
begin;

do $$
declare a uuid := '__A_USER_UUID__'; b uuid := '__B_USER_UUID__';
begin
  if a = b then raise exception 'A and B must be distinct Auth users'; end if;
  if (select count(*) from auth.users where id in (a,b) and email_confirmed_at is not null) <> 2 then
    raise exception 'Both confirmed Auth test users must exist';
  end if;
  if exists (select 1 from public.organizations where id in
     ('93a88055-0a0b-40c0-b22f-a6d312320001','93a88055-0a0b-40c0-b22f-a6d312320002')) then
    raise exception 'Fixture organizations already exist; inspect before retrying';
  end if;
end $$;

