{
  "version": 2,
  "buildCommand": "node delivery/web-preview/build.mjs && node delivery/web-preview/handoff-bridge.mjs && node delivery/web-preview/review-flag.mjs",
  "outputDirectory": "delivery/web-preview/dist",
  "functions": {
    "api/product-source.py": {
      "includeFiles": "prototype/public-audit/{scanner,product_source,product_api,first_result_api,robots_policy,error_classify,service_source,service_api,declared_product}.py",
      "maxDuration": 60
    },
    "api/service-source.py": {
      "includeFiles": "prototype/public-audit/{scanner,product_source,product_api,first_result_api,robots_policy,error_classify,service_source,service_api,declared_product}.py",
      "maxDuration": 60
    }
  }
}
